rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Solo pueden leer y escribir los dos usuarios de la app (cambia los correos por los reales)
      allow read, write: if request.auth != null
        && request.auth.token.email in ['andrea@correo.com', 'martin@correo.com'];
    }
  }
}
